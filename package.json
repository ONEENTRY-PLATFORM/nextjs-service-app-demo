    "test:e2e:start": "cross-env E2E_BUILD=1 next start -p 3010",
    "test:e2e:server": "npm run test:e2e:build && npm run test:e2e:start",
    "analyze": "next experimental-analyze",
    "analyze:webpack": "cross-env ANALYZE=true next build --webpack"
  },
