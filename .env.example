NEXT_PUBLIC_ONEENTRY_URL=https://xxx-xxx-xxx.xxx
NEXT_PUBLIC_ONEENTRY_TOKEN=xxxxx...

NEXT_PUBLIC_VERCEL_URL="https://xxx-xxx-xxx.vercel.app/"

# NEXT_PUBLIC_VERCEL_URL, then http://localhost:3700.
NEXT_PUBLIC_SITE_URL=https://xxx-xxx-xxx.xxx

# Google OAuth secrets
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxx-xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxx
# App origin used as a server-side fallback for the OAuth redirect_uri.
# redirect_uri is `${origin}/auth/callback/google`; whitelist it in Google Cloud Console.
# Dev: http://localhost:3700 — Prod: your deployed https origin.
NEXT_PUBLIC_APP_URL=http://localhost:3700
