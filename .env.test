# Loaded by next/jest when NODE_ENV=test. Next deliberately skips .env.local in
# the test environment, and `.env` is gitignored here — so without this file the
# Jest suites that import app/api/api/api.ts die on its fail-fast env guard
# before a single test runs (5 suites / 9 tests, "OneEntry SDK misconfigured").
#
# Placeholders on purpose: the Jest suites are unit tests (pure helpers, hooks
# with a mocked SDK) and never reach the CMS — they only need the guard to pass.
# Real credentials stay in .env / .env.local, which serve dev, build and e2e.
NEXT_PUBLIC_ONEENTRY_URL=https://example.oneentry.cloud
NEXT_PUBLIC_ONEENTRY_TOKEN=test-app-token
